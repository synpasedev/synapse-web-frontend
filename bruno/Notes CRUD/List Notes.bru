meta {
  name: List Workspace Notes
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/notes?workspaceId=ws-default-synapse
  body: none
  auth: none
}

tests {
  test("status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("returns array of notes", function() {
    expect(res.getBody().data).to.be.an('array');
  });
}
