{
  "info": {
    "name": "Synapse Workspace Complete REST & Route API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Complete REST API Collection for Synapse (Notes CRUD, Blocks CRUD, Databases CRUD, Workspaces, AI Assistants, Auth, SSR routes)"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Notes CRUD",
      "item": [
        {
          "name": "List Workspace Notes",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/notes?workspaceId=ws-default-synapse",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "notes"
              ],
              "query": [
                {
                  "key": "workspaceId",
                  "value": "ws-default-synapse"
                }
              ]
            }
          }
        },
        {
          "name": "Create New Note",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"workspaceId\": \"ws-default-synapse\",\n  \"title\": \"API Created Note 🚀\",\n  \"icon\": \"🚀\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/notes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "notes"
              ]
            }
          }
        },
        {
          "name": "Get Note by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/notes/note-welcome",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "notes",
                "note-welcome"
              ]
            }
          }
        },
        {
          "name": "Update Note Properties",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Welcome to Synapse ⚡ (Updated)\",\n  \"is_favorite\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/notes/note-welcome",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "notes",
                "note-welcome"
              ]
            }
          }
        },
        {
          "name": "Delete or Archive Note",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/notes/note-welcome",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "notes",
                "note-welcome"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Blocks CRUD",
      "item": [
        {
          "name": "Get Note Blocks",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/blocks?noteId=note-welcome",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "blocks"
              ],
              "query": [
                {
                  "key": "noteId",
                  "value": "note-welcome"
                }
              ]
            }
          }
        },
        {
          "name": "Batch Save Blocks",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"noteId\": \"note-welcome\",\n  \"workspaceId\": \"ws-default-synapse\",\n  \"blocks\": [\n    {\n      \"id\": \"block-test-1\",\n      \"type\": \"heading_1\",\n      \"content\": {\n        \"text\": \"Programmatic Block\"\n      },\n      \"sort_order\": 1000\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/blocks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "blocks"
              ]
            }
          }
        }
      ]
    },
